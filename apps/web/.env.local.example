# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and adjust. Defaults below serve fixtures everywhere.
# For CI builds use .env.ci.example instead — it contains safe placeholder values
# that satisfy the Zod validation gate without any real credentials.
#
# Mock vs real resolution: USE_*_MOCKS=true → mock; else API_UPSTREAM_URL +
# service API_KEY set → real BED; else → 503. For all-fixtures dev, keep
# API_UPSTREAM_URL unset (setting it also flips legacy geo/recs/VDP to real).
#
# Surfaces: SERVER-ONLY vars stay out of the browser (safe for secrets);
# CLIENT (NEXT_PUBLIC_*) vars are inlined into the bundle — non-secret only.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# SERVER-ONLY
# ═════════════════════════════════════════════════════════════════════════════

# ── BED (backend) services — commented out for all-fixtures dev ──────────────
# All BED services share ONE domain; each adds its own versioned path prefix and
# its own API key. The BFF composes `${API_UPSTREAM_URL}${*_API_PATH}` per
# service (see src/config/bed-services.ts). Uncomment the domain + a service's
# key to call the real BED for that (migrated) service.
# NOTE: until the legacy sweep lands, setting the domain also flips geo/search/
# recommendations/VDP to real — so uncomment with that in mind.
# API_UPSTREAM_URL=https://api.sandbox.arrow.toyotafinancial.com
# BED_TENANT_ID=                       # X-Tenant-Id (required for real BED)
# VISITORS_API_PATH=/visitors          # optional; defaults to /visitors in code
# VISITORS_API_KEY=                    # Per-service key for visitors (X-API-Key)
# SEARCH_API_PATH=/search/v1           # optional; defaults to /search/v1 (set /vehicles/v1 for legacy endpoint)
# SEARCH_API_KEY=                      # Per-service key for search (X-API-Key)
# VDP_API_PATH=/vehicles/v1            # optional; defaults to /vehicles/v1 in code
# VDP_API_KEY=                         # Per-service key for VDP (X-API-Key)
# GEO_API_PATH=/geo/v1                 # optional; defaults to /geo/v1 in code
# GEO_API_KEY=                         # Per-service key for geo (X-API-Key)
# GEO_DEALER_ID=                       # X-Dealer-Id sent to the geo service
# UPSTREAM_TIMEOUT_MS=8000             # optional; proxy upstream timeout in ms (default: 30000)

# ── Origination BFF (FND-01) — third-party providers kept as separate services ──
# Core origination flow + isolated Experian identity and trade-in valuation
# services, each with its own key/path so credentials/versioning/outages stay
# isolated. The whole domain is mocked now (USE_ORIGINATION_MOCKS below); swap to
# real BED by uncommenting the domain + the relevant key.
# ORIGINATION_API_PATH=/origination/v1                    # optional; defaults to /origination/v1 in code
# ORIGINATION_API_KEY=                                    # Per-service key for origination (X-API-Key)
# ORIGINATION_IDENTITY_API_PATH=/origination-identity/v1  # optional; defaults in code — Experian (BFF-03)
# ORIGINATION_IDENTITY_API_KEY=                           # Per-service key for identity (X-API-Key)
# ORIGINATION_TRADEIN_API_PATH=/origination-tradein/v1    # optional; defaults in code — valuation (BFF-04)
# ORIGINATION_TRADEIN_API_KEY=                            # Per-service key for trade-in (X-API-Key)

# ── BED per-endpoint versioning (optional) ───────────────────────────────────
# The visitors service base is version-agnostic (/visitors); each endpoint
# carries its own version (see src/config/bed-services.ts). Precedence per
# endpoint: the endpoint's own var → the service-wide var → "v1".
# Bump the whole visitors service:
# VISITORS_API_VERSION=v1
# Bump a single endpoint (overrides the service-wide var above):
# VISITORS_RESOLVE_VERSION=v1
# VISITORS_SUGGESTIONS_VERSION=v1
# VISITORS_WATCHLIST_VERSION=v1
# VISITORS_ACTIVITIES_VERSION=v1
# VISITORS_SEARCHES_VERSION=v1
# VISITORS_PREFERENCES_VERSION=v1

# ── BFF mock toggles — each WINS over a configured service ────────────────────
# Set true to force fixtures for that feature regardless of domain/keys.
#
# To integrate the REAL visitors service (profile resolve + suggestions):
#   1. uncomment API_UPSTREAM_URL + VISITORS_API_KEY + BED_TENANT_ID above, then
#   2. flip the flag below to false:
#        USE_PROFILE_MOCKS=false
USE_PROFILE_MOCKS=true              # profile resolve + suggestions (visitors) — set false for real BED
USE_PROFILE_SUGGESTIONS_MOCKS=true  # profile suggestions, independent of the resolve mock flag
USE_PROFILE_APPOINTMENT_MOCKS=true  # profile appointments & offers — set false + upstream for real BED
USE_PROFILE_SEARCH_MOCKS=true       # profile recent searches (search/recent)
USE_TRADE_IN_MOCKS=true             # profile trade-in vehicles (get-trade-in-vehicles)
USE_TRADE_IN_LOOKUP_MOCKS=true      # trade-in vehicle lookup — simulates 2s valuation delay
USE_COMPARE_MOCKS=true              # profile watchlist compare vehicles (get-compare-vehicles)
USE_SEARCH_MOCKS=true               # search recent + suggestions (typeahead)
USE_SEARCH_RESULTS_MOCKS=true       # search results + New Today — set false + SEARCH_API_KEY for real BED
USE_SEARCH_AGENT_MOCKS=true         # conversational agent SSE stream (see SEARCH_AGENT_BACKEND below)
USE_AUTOCOMPLETE_MOCKS=true         # search autocomplete
USE_FILTERS_MOCKS=true              # search facets / smart filters
USE_VDP_MOCKS=true                  # vehicle detail page (VDP)
USE_RECOMMENDATIONS_MOCKS=true      # "because you viewed" recommendations
USE_GEO_MOCKS=true                  # zip → geo lookups — set false + GEO_API_KEY for real Arrow Geo API

# ── Origination BFF mock toggle (FND-01) ─────────────────────────────────────
# One flag covers the whole origination domain (all BFF-01…BFF-09 endpoints +
# the state-transition PATCH). Set false + configure the ORIGINATION_* services
# above to call the real BED.
USE_ORIGINATION_MOCKS=true          # origination flow (phone/OTP/identity/trade-in/income/credit/offers/patch)

# ── Profile activity capture — immediate (not queued) in dev ─────────────────
PROFILE_ACTIVITY_MODE=immediate

# ── Landing sections ─────────────────────────────────────────────────────────
NEW_TODAY_DAYS_IN_STOCK=12           # max daysInStock filter for "New Today" section
NEW_TODAY_LIMIT=10                   # max vehicles for "New Today" section
RARE_FINDS_LIMIT=3                   # max vehicles for "Rare Finds" section

# ── Car-Cutter 360° & gallery ────────────────────────────────────────────────
# Gallery hash for this dealer's Car-Cutter account. Server-only; store as a secret.
CAR_CUTTER_GALLERY_HASH=your-car-cutter-gallery-hash-here

# ── Media proxy (optional) ───────────────────────────────────────────────────
# HEADER_X_ORIGIN_VERIFY enables the /api/v1/media proxy; unset = proxy disabled.
# HEADER_X_ORIGIN_VERIFY=your-origin-verify-key-here
MEDIA_UPSTREAM_TIMEOUT_MS=10000      # upstream media fetch timeout in ms
MEDIA_CACHE_MAX_AGE=86400            # fallback Cache-Control max-age in seconds

# ── Card image source ────────────────────────────────────────────────────────
# "always"   → replace ALL card images with stock images (ignore API URLs)
# "fallback" → use API image when valid, stock image when empty/invalid
# "none"     → pass API images through as-is
USE_STOCK_IMAGES=none

# ── Revalidation ─────────────────────────────────────────────────────────────
# Shared secret protecting the /api/v1/revalidate on-demand cache route.
REVALIDATION_SECRET=your-revalidation-secret-here

# ── Feature flags (optional) ─────────────────────────────────────────────────
# Vercel Flags SDK toolbar-override secret. Only needed for the Flags Explorer.
# FLAGS_SECRET=

# ── Fingerprint — server (Events API) ────────────────────────────────────────
FINGERPRINT_API_KEY=                 # server Events API key; blank = disabled
FINGERPRINT_REGION=us                # us | eu | ap

# Dev location seed — overrides fingerprint geo. Format: ZIP,LAT,LNG.
# DEV_SEED_LOCATION=90210,34.074,-118.4

# ── Cookie encryption (optional) ─────────────────────────────────────────────
# Base64url AES-256 (32 bytes). Unset = opaque base64. Generate: openssl rand -base64 32
# ENCRYPTION_KEY=

# ── Dev toggles ──────────────────────────────────────────────────────────────
# FORCE_VDP_SOLD=true                # force the VDP "vehicle sold" layout for any VIN

# ── Mock latency ─────────────────────────────────────────────────────────────
MOCK_LATENCY=false                   # true = simulate network delay in non-streaming mock services
# SEARCH_AGENT_MOCK_DELAY_MS=2000    # ms between static_mock agent SSE stage frames (default: 120)

# ─── Search Agent Backend Routing ─────────────────────────────────────────────
# Which backend serves the conversational search stream. The `demo-agent-backend`
# cookie (/demo-settings) overrides this per browser. Default: "v2".
#   static_mock — offline fixture SSE stream
#   v1          — Arrow agent via BED search service (v1 payload)
#   v2          — Arrow agent via BED search service (v2 payload; API_UPSTREAM_URL + SEARCH_API_KEY + BED_TENANT_ID)
SEARCH_AGENT_BACKEND=static_mock

# V3 agent upstream (optional; used by the v3 agent path when configured)
SEARCH_AGENT_V3_URL=                                # v3 agent base URL
SEARCH_AGENT_V3_PATH=/api/search/agent              # v3 agent endpoint path
SEARCH_AGENT_V3_COOKIE=                             # auth cookie forwarded to the v3 API — get from: TBD

# ─── Search Agent Debug Capture (dev-only) ────────────────────────────────────
# true = write raw agent SSE traces to apps/web/.debug/search (viewable at /debug/agent).
SEARCH_AGENT_DEBUG=false

# ═════════════════════════════════════════════════════════════════════════════
# CLIENT (NEXT_PUBLIC_*) — inlined into the browser bundle. NON-SECRET ONLY.
# ═════════════════════════════════════════════════════════════════════════════

# ── Mocks ────────────────────────────────────────────────────────────────────
# Forces the profile watchlist BFF (get/add/remove) to return fixtures instead
# of calling the real visitors service. Drives the profile Compare CTA and the
# /demo-settings watchlist vehicle-count picker.
NEXT_PUBLIC_MOCKS=true

# ── Public URLs ──────────────────────────────────────────────────────────────
# Media CDN — resolves upstream "public/<hash>/<file>" paths to absolute URLs.
NEXT_PUBLIC_MEDIA_CDN_URL=https://media.sandbox.arrow.toyotafinancial.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
# Base for building absolute URLs in profile suggestion fixtures/responses.
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:3000

# ── Landing sections ─────────────────────────────────────────────────────────
# Max vehicles returned by the taxonomy search (Search Recommendations carousel).
NEXT_PUBLIC_SEARCH_RECS_LIMIT=20

# ── Fingerprint — browser agent ──────────────────────────────────────────────
NEXT_PUBLIC_FINGERPRINT_API_KEY=     # public browser agent key; blank = disabled
NEXT_PUBLIC_FINGERPRINT_REGION=us    # us | eu | ap

# ── Cookie encryption (optional) ─────────────────────────────────────────────
# Client-visible counterpart to ENCRYPTION_KEY; set only if the browser decrypts.
# NEXT_PUBLIC_ENCRYPTION_KEY=

# ── Passkey demo (dev-only mock relying party) ───────────────────────────────
# NEXT_PUBLIC_PASSKEY_API_BASE=          # leave unset → same-origin /api/auth/passkey (mock); set to the BED base when available
# RP_ID=demo.example.com                 # default: derived from the request host
# RP_ORIGIN=https://demo.example.com     # default: derived from the request
# RP_NAME="UCMP passkey demo"
