# ─────────────────────────────────────────────────────────────────────────────
# CI environment stubs — safe placeholder values for every var in env-schema.ts
#
# Purpose: satisfy the Zod validation gate in next.config.ts and the runtime
# module in src/config/env.ts so that `pnpm build` and `pnpm test` pass in CI
# without real upstream credentials.
#
# Rules:
#   - No real secrets or service keys. Placeholders only.
#   - URL vars are left empty ("") — the optUrl preprocessor converts "" → undefined.
#   - All USE_*_MOCKS flags are "true" so no real upstream is ever contacted.
#   - REVALIDATION_SECRET is set to a non-empty placeholder so the production
#     check (z.string().min(1) when NODE_ENV=production) is satisfied.
#
# See: docs/adr/0011-typed-env-vars.md
# ─────────────────────────────────────────────────────────────────────────────

# ── BED shared domain ───────────────────────────────────────────────────────
# optUrl preprocesses "" → undefined, so empty string is safe here.
API_UPSTREAM_URL=
# optStr uses z.string().min(1) — omit rather than set to "" to get undefined.
# BED_TENANT_ID=
# UPSTREAM_TIMEOUT_MS=

# ── BED per-service keys & path overrides ───────────────────────────────────
# All omitted — schema treats absent vars as undefined (all are optStr).
# VISITORS_API_KEY=
# VISITORS_API_PATH=
# SEARCH_API_KEY=
# SEARCH_API_PATH=
# VDP_API_KEY=
# VDP_API_PATH=
# GEO_API_KEY=
# GEO_API_PATH=
# GEO_DEALER_ID=
# ORIGINATION_API_KEY=
# ORIGINATION_API_PATH=
# ORIGINATION_IDENTITY_API_KEY=
# ORIGINATION_IDENTITY_API_PATH=
# ORIGINATION_TRADEIN_API_KEY=
# ORIGINATION_TRADEIN_API_PATH=

# ── Revalidation secret — placeholder satisfies production z.string().min(1) ─
REVALIDATION_SECRET=ci-placeholder

# ── Third-party services ────────────────────────────────────────────────────
# FINGERPRINT_API_KEY=
# FINGERPRINT_REGION=
# CAR_CUTTER_GALLERY_HASH=

# ── Shared infrastructure ───────────────────────────────────────────────────
# HEADER_X_ORIGIN_VERIFY=
# ENCRYPTION_KEY=
# MEDIA_UPSTREAM_TIMEOUT_MS=
# MEDIA_CACHE_MAX_AGE=

# ── Search agent ────────────────────────────────────────────────────────────
# SEARCH_AGENT_BACKEND=
# SEARCH_AGENT_V3_URL=
# SEARCH_AGENT_V3_PATH=
# SEARCH_AGENT_V3_COOKIE=
# SEARCH_AGENT_MOCK_DELAY_MS=
# SEARCH_AGENT_DEBUG=

# ── Feature config ──────────────────────────────────────────────────────────
PROFILE_ACTIVITY_MODE=immediate
# USE_STOCK_IMAGES=
# NEW_TODAY_DAYS_IN_STOCK=
# NEW_TODAY_LIMIT=
# RARE_FINDS_LIMIT=
# DEV_SEED_LOCATION=
# MOCK_LATENCY=
# FORCE_VDP_SOLD=

# ── Mock toggles — all enabled so no real upstream is contacted ──────────────
USE_PROFILE_MOCKS=true
USE_PROFILE_APPOINTMENT_MOCKS=true
USE_PROFILE_SUGGESTIONS_MOCKS=true
USE_PROFILE_SEARCH_MOCKS=true
USE_SEARCH_MOCKS=true
USE_SEARCH_RESULTS_MOCKS=true
USE_SEARCH_AGENT_MOCKS=true
USE_AUTOCOMPLETE_MOCKS=true
USE_FILTERS_MOCKS=true
USE_VDP_MOCKS=true
USE_RECOMMENDATIONS_MOCKS=true
USE_GEO_MOCKS=true
USE_TRADE_IN_MOCKS=true
USE_ORIGINATION_MOCKS=true
USE_TRADE_IN_LOOKUP_MOCKS=true

# ── NEXT_PUBLIC_* vars ───────────────────────────────────────────────────────
# optUrl vars: empty string is safe (preprocessed to undefined).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MEDIA_CDN_URL=
NEXT_PUBLIC_IMAGE_BASE_URL=
# optStr / coerce.number / boolStr vars: omit to get undefined.
# NEXT_PUBLIC_FINGERPRINT_API_KEY=
# NEXT_PUBLIC_FINGERPRINT_REGION=
# NEXT_PUBLIC_MOCKS=
# NEXT_PUBLIC_SEARCH_RECS_LIMIT=
# NEXT_PUBLIC_ENCRYPTION_KEY=
